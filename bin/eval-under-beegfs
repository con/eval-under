#!/bin/bash
# SPDX-FileCopyrightText: 2026 Yaroslav Halchenko <yaroslav.o.halchenko@dartmouth.edu>
# SPDX-License-Identifier: MIT
#
# Generated with Claude Code 2.1.233 / Claude Opus 4.7
#
# eval-under-beegfs: run a command with TMPDIR / DATALAD_TESTS_TEMP_DIR (and
# optionally HOME) pointing at a BeeGFS mount, backed by a containerised
# BeeGFS cluster (mgmtd + meta + storage) brought up via docker compose.
#
# Backend of the eval-under framework. See `eval-under --help` for the
# top-level dispatcher, and `eval-under-beegfs --help` for the option and
# env-var tables below.

set -eu

here="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(cd "$here/.." && pwd)"

# Defaults (options override; env vars override defaults).
MNT="${EVAL_UNDER_MOUNT:-/mnt/beegfs}"
DATA_ROOT="${EVAL_UNDER_BEEGFS_DATA_ROOT:-/beegfs}"
VERSION="${EVAL_UNDER_BEEGFS_VERSION:-7.4.6}"
STARTUP_WAIT="${EVAL_UNDER_BEEGFS_STARTUP_WAIT:-60}"
MOUNT_READY_WAIT="${EVAL_UNDER_BEEGFS_MOUNT_READY_WAIT:-60}"
KEEP="${EVAL_UNDER_KEEP:-0}"
SET_HOME="${EVAL_UNDER_HOME_ON_MOUNT:-0}"

CONF_ACTIVE="/etc/beegfs/beegfs-client-test.conf"
HELPERD_ACTIVE="/etc/beegfs/beegfs-helperd-test.conf"
HELPERD_BIN="/opt/beegfs/sbin/beegfs-helperd"

usage() {
  cat <<'EOF'
Usage: eval-under-beegfs [OPTIONS] -- CMD [ARGS...]

Run CMD with TMPDIR / DATALAD_TESTS_TEMP_DIR (and optionally HOME)
pointing at a BeeGFS mount, backed by a containerised BeeGFS cluster
(mgmtd + meta + storage) brought up via docker compose.

Options (flag / env var / default / purpose):

  --mount-point PATH   EVAL_UNDER_MOUNT               /mnt/beegfs
      Where to mount BeeGFS on the host.

  --set-home           EVAL_UNDER_HOME_ON_MOUNT       (unset)
      Also set HOME=<mount>/home for the wrapped command. Catches the
      class of bugs seen when HOME itself lives on the tested FS.

  --keep               EVAL_UNDER_KEEP                (unset)
      Skip teardown; leave containers + mount up for debugging.

  --version VER        EVAL_UNDER_BEEGFS_VERSION      7.4.6
      Selects the ghcr.io/thinkparq/beegfs-* image tag AND the matching
      client-DKMS branch. Major version picks the compose file:
        7.x  ->  fixtures/beegfs/docker-compose-v7.yml
        8.x  ->  fixtures/beegfs/docker-compose-v8.yml

  --data-root PATH     EVAL_UNDER_BEEGFS_DATA_ROOT    /beegfs
      Host dir for container-side target dirs (mgmtd + meta + storage).

  --startup-wait S     EVAL_UNDER_BEEGFS_STARTUP_WAIT 60
      Seconds to wait for mgmtd(8008) + meta(8005) + storage(8003) to
      bind before giving up.

  --mount-ready-wait S EVAL_UNDER_BEEGFS_MOUNT_READY_WAIT 60
      How long to keep probing a freshly-mounted BeeGFS with a real
      create+write before giving up. mount(8) returning is not the same
      as the mount being usable -- see wait_for_mount_usable().

  -h, --help
      Print this help.

Environment variables set FOR the wrapped command (all backends):

  TMPDIR                     = <mount>
  DATALAD_TESTS_TEMP_DIR     = <mount>
  HOME                       = <mount>/home        (only if --set-home)

Exit status: the wrapped command's exit status. Teardown runs on any
exit (unless --keep).
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --keep) KEEP=1; shift ;;
    --mount-point) MNT="$2"; shift 2 ;;
    --set-home) SET_HOME=1; shift ;;
    --version) VERSION="$2"; shift 2 ;;
    --data-root) DATA_ROOT="$2"; shift 2 ;;
    --startup-wait) STARTUP_WAIT="$2"; shift 2 ;;
    --mount-ready-wait) MOUNT_READY_WAIT="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[ $# -gt 0 ] || { echo "no command given" >&2; usage >&2; exit 2; }

# Pick compose file by major version. v7 and v8 use different mgmtd command
# styles (confstring vs proper CLI flags) so a single template doesn't fit.
MAJOR="${VERSION%%.*}"
COMPOSE="$repo_root/fixtures/beegfs/docker-compose-v${MAJOR}.yml"
[ -f "$COMPOSE" ] || {
  echo "ERROR: no compose file for BeeGFS v${MAJOR} (looked for $COMPOSE)" >&2
  exit 2
}
CONF_TEMPLATE="$repo_root/fixtures/beegfs/beegfs-client.conf.template"
HELPERD_TEMPLATE="$repo_root/fixtures/beegfs/beegfs-helperd.conf.template"

if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null || {
    echo "must run as root (or have sudo available)" >&2; exit 2; }
  SUDO=(sudo)
  SUDO_E=(sudo -E)
else
  SUDO=()
  SUDO_E=()
fi

log() { printf '\nI: %s\n' "$*"; }

ensure_client_installed() {
  if modinfo beegfs >/dev/null 2>&1; then return 0; fi
  echo "ERROR: beegfs kernel module not available." >&2
  echo "  Install with: apt install beegfs-client-dkms beegfs-helperd beegfs-utils" >&2
  exit 3
}

start_cluster() {
  log "creating data dirs under $DATA_ROOT"
  "${SUDO[@]}" mkdir -p \
    "$DATA_ROOT/mgmt_tgt_mgmt01" \
    "$DATA_ROOT/meta_01_tgt_0101" \
    "$DATA_ROOT/stor_01_tgt_101" \
    "$DATA_ROOT/stor_01_tgt_102"

  log "docker compose up (BeeGFS ${VERSION} via $(basename "$COMPOSE"))"
  BEEGFS_DATA_ROOT="$DATA_ROOT" \
  BEEGFS_IMAGE_TAG="$VERSION" \
    "${SUDO_E[@]}" docker compose -f "$COMPOSE" up -d

  log "waiting up to ${STARTUP_WAIT}s for mgmtd(8008) + meta(8005) + storage(8003)"
  # All three must be listening AND meta must have registered with mgmtd
  # (mount sanity check queries the root metadata node). Waiting on the
  # meta TCP port is a reasonable proxy since meta binds after registering.
  local waited=0
  while [ "$waited" -lt "$STARTUP_WAIT" ]; do
    local ports
    ports=$("${SUDO[@]}" ss -ltn 2>/dev/null | awk '{print $4}' | awk -F: '{print $NF}')
    if grep -qx 8008 <<<"$ports" \
      && grep -qx 8005 <<<"$ports" \
      && grep -qx 8003 <<<"$ports"; then
      log "cluster is up (after ${waited}s)"
      # Small extra grace period for meta to finish node registration.
      sleep 2
      return 0
    fi
    sleep 2
    waited=$((waited + 2))
  done
  echo "ERROR: cluster did not come up within ${STARTUP_WAIT}s" >&2
  "${SUDO[@]}" docker compose -f "$COMPOSE" logs --tail=200 >&2 || true
  exit 4
}

write_confs() {
  log "writing $CONF_ACTIVE"
  "${SUDO[@]}" install -d /etc/beegfs
  "${SUDO[@]}" install -m 0644 "$CONF_TEMPLATE"    "$CONF_ACTIVE"
  # BeeGFS v8 dropped the standalone beegfs-helperd binary; the mount
  # sanity check that talks to helperd on tcp/8006 would then fail. If
  # we're not going to start helperd, disable the sanity check.
  if [ ! -x "$HELPERD_BIN" ]; then
    log "no helperd binary at $HELPERD_BIN -- disabling sysMountSanityCheckMS"
    echo "sysMountSanityCheckMS = 0" \
      | "${SUDO[@]}" tee -a "$CONF_ACTIVE" >/dev/null
  else
    "${SUDO[@]}" install -m 0644 "$HELPERD_TEMPLATE" "$HELPERD_ACTIVE"
  fi
}

start_helperd() {
  if [ ! -x "$HELPERD_BIN" ]; then
    log "skipping beegfs-helperd (binary absent -- BeeGFS v8+ folds it in)"
    return 0
  fi
  # The shipped systemd unit reads /etc/beegfs/beegfs-helperd.conf, which
  # has auth enabled by default and would refuse to start. Bypass systemd
  # and launch helperd directly with our test conf. runDaemonized=true in
  # the conf means it forks and returns immediately.
  log "starting beegfs-helperd (direct, cfgFile=$HELPERD_ACTIVE)"
  "${SUDO[@]}" systemctl stop beegfs-helperd 2>/dev/null || true
  "${SUDO[@]}" "$HELPERD_BIN" "cfgFile=$HELPERD_ACTIVE"
  local w=0
  while [ "$w" -lt 5 ]; do
    if "${SUDO[@]}" ss -ltn "sport = :8006" 2>/dev/null | grep -q :8006; then
      return 0
    fi
    sleep 1; w=$((w+1))
  done
  echo "ERROR: beegfs-helperd did not bind to tcp/8006" >&2
  "${SUDO[@]}" tail -50 /var/log/beegfs-helperd-test.log 2>&1 >&2 || true
  exit 5
}

# `mount -t beegfs` returns as soon as the client module has registered
# with mgmtd and downloaded the node groups -- which is *not* the same as
# its connections to the meta and storage nodes being usable. The kernel
# happily logs "BeeGFS mount ready" and the very next metadata operation
# then fails with ECOMM ("Communication error on send").
#
# That is a race, so it shows up as a cell that was green last run and is
# red this one, with a one-line error and no suite output at all -- the
# most expensive kind of red to debug, because it looks like a finding
# about the filesystem and is not.
#
# start_cluster() already waits for the three daemons to bind, but a
# listening port only proves the server side is up. The client side needs
# its own probe, and it has to be a real operation: create + write + read
# back exercises the meta node (create) and a storage target (write), so
# a success means the mount can actually do work.
wait_for_mount_usable() {
  local probe="$MNT/.eval-under-ready.$$"
  local waited=0 err=""
  log "probing mount usability (up to ${MOUNT_READY_WAIT}s)"
  while [ "$waited" -lt "$MOUNT_READY_WAIT" ]; do
    if err=$("${SUDO[@]}" dd if=/dev/urandom of="$probe" bs=4k count=1 2>&1) \
      && err=$("${SUDO[@]}" dd if="$probe" of=/dev/null bs=4k count=1 2>&1); then
      "${SUDO[@]}" rm -f "$probe" 2>/dev/null || true
      log "mount is usable (after ${waited}s)"
      return 0
    fi
    "${SUDO[@]}" rm -f "$probe" 2>/dev/null || true
    sleep 1
    waited=$((waited + 1))
  done
  echo "ERROR: BeeGFS mounted at $MNT but unusable after ${MOUNT_READY_WAIT}s" >&2
  echo "       last probe error: $err" >&2
  "${SUDO[@]}" dmesg 2>/dev/null | grep -i beegfs | tail -30 >&2 || true
  exit 6
}

mount_beegfs() {
  log "mounting BeeGFS at $MNT"
  "${SUDO[@]}" mkdir -p "$MNT"
  "${SUDO[@]}" mount -t beegfs beegfs_nodev "$MNT" -o "cfgFile=$CONF_ACTIVE"
  wait_for_mount_usable
  "${SUDO[@]}" chown "$(id -u):$(id -g)" "$MNT"
  "${SUDO[@]}" mount | grep -F "$MNT" | sed 's/^/I: /'
}

teardown() {
  local rc=$?
  set +e
  if [ "$KEEP" = 1 ]; then
    echo "I: --keep set; leaving cluster + mount up (exit=$rc)"
    return "$rc"
  fi
  log "teardown"
  "${SUDO[@]}" umount "$MNT" 2>/dev/null || true
  if [ -x "$HELPERD_BIN" ]; then
    "${SUDO[@]}" pkill -f "$HELPERD_BIN" 2>/dev/null || true
  fi
  BEEGFS_DATA_ROOT="$DATA_ROOT" \
    "${SUDO_E[@]}" docker compose -f "$COMPOSE" down -v 2>/dev/null || true
  "${SUDO[@]}" rm -rf "$DATA_ROOT" "$CONF_ACTIVE" "$HELPERD_ACTIVE"
  return "$rc"
}
trap teardown EXIT

ensure_client_installed
start_cluster
write_confs
start_helperd
mount_beegfs

RUN_HOME="$HOME"
if [ "$SET_HOME" = 1 ]; then
  RUN_HOME="$MNT/home"
  mkdir -p "$RUN_HOME"
fi

log "running: $*"
HOME="$RUN_HOME" TMPDIR="$MNT" DATALAD_TESTS_TEMP_DIR="$MNT" "$@"
