#!/bin/bash
# SPDX-FileCopyrightText: 2026 Yaroslav Halchenko <yaroslav.o.halchenko@dartmouth.edu>
# SPDX-License-Identifier: MIT
#
# Generated with Claude Code 2.1.233 / Claude Opus 4.7
#
# eval-under: tiny dispatcher for the eval-under family of backends.
# Delegates to bin/eval-under-<BACKEND>.
#
#   eval-under BACKEND [BACKEND_OPTIONS...] -- CMD [ARGS...]
#   eval-under --list
#   eval-under --help
#   eval-under BACKEND --help
#   eval-under --version

set -eu

here="$(cd "$(dirname "$0")" && pwd)"

# Version reported when this script is NOT running out of its own git
# checkout (installed copy, release tarball, distribution package).
# Bump this together with the release tag.
VERSION_FALLBACK="0.1.0"

version() {
  local top
  # Derive the version from the checkout this script lives in:
  #   0.1.0             on a release tag
  #   0.1.0-4-g1a2b3c4  four commits past it
  #   1a2b3c4           no tag in this commit's history
  #   <any>-dirty       uncommitted changes in the checkout
  # --tags so lightweight tags count too, not just annotated ones.
  #
  # The $top/bin test is what distinguishes "running from a source
  # checkout" from "installed copy that happens to sit inside some other
  # repo". No git, no repo, or a repo git refuses (`safe.directory`) all
  # fail quietly and fall through to the baked-in value. --no-optional-
  # locks so --dirty cannot leave a refreshed .git/index behind.
  if top="$(git -C "$here" rev-parse --show-toplevel 2>/dev/null)" \
     && [ "$here" -ef "$top/bin" ]; then
    git --no-optional-locks -C "$here" describe --tags --always --dirty \
      2>/dev/null && return 0
  fi
  echo "$VERSION_FALLBACK"
}

list_backends() {
  # Any executable in $here named eval-under-<something>.
  local f name
  for f in "$here"/eval-under-*; do
    [ -x "$f" ] || continue
    name="${f##*/eval-under-}"
    echo "$name"
  done
}

usage() {
  cat <<EOF
Usage: eval-under BACKEND [BACKEND_OPTIONS...] -- CMD [ARGS...]
       eval-under --list
       eval-under --help
       eval-under BACKEND --help
       eval-under --version

Run CMD with TMPDIR / DATALAD_TESTS_TEMP_DIR (and optionally HOME)
pointing at a temporarily-mounted filesystem, selected by BACKEND.

Backends available on this system:
EOF
  local b
  for b in $(list_backends); do
    echo "  - $b"
  done
  cat <<'EOF'

Common options recognised by every backend:

  --mount-point PATH   EVAL_UNDER_MOUNT
  --set-home           EVAL_UNDER_HOME_ON_MOUNT
  --keep               EVAL_UNDER_KEEP

Env vars set FOR the wrapped command (all backends):

  TMPDIR                     = <mount>
  DATALAD_TESTS_TEMP_DIR     = <mount>
  HOME                       = <mount>/home        (only if --set-home)

Backend-specific options and env vars: run `eval-under BACKEND --help`.
EOF
}

if [ $# -eq 0 ]; then
  usage >&2
  exit 2
fi

case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  --list)
    list_backends
    exit 0
    ;;
  -V|--version)
    echo "eval-under $(version)"
    exit 0
    ;;
  --*)
    echo "unknown top-level option: $1" >&2
    usage >&2
    exit 2
    ;;
esac

backend="$1"
shift
target="$here/eval-under-$backend"

if [ ! -x "$target" ]; then
  echo "eval-under: unknown backend '$backend'" >&2
  echo "available:" >&2
  list_backends | sed 's/^/  /' >&2
  exit 2
fi

exec "$target" "$@"
