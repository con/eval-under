#!/bin/bash
# SPDX-FileCopyrightText: 2026 Yaroslav Halchenko <yaroslav.o.halchenko@dartmouth.edu>
# SPDX-License-Identifier: MIT
#
# Generated with Claude Code 2.1.233 / Claude Opus 4.7
#
# eval-under-loop: run a command with TMPDIR / DATALAD_TESTS_TEMP_DIR (and
# optionally HOME) pointing at a loop-mounted local filesystem (create a
# backing image, losetup, mkfs.<fs>, mount).
#
# Backend of the eval-under framework. Absorbed from datalad's
# tools/eval_under_testloopfs, with framework env-var names, a teardown
# trap, and a default backing size bumped from 10MB to 100MB (git-annex's
# testsuite blows past the tiny original in seconds).

set -eu

# Defaults (options override; env vars override defaults).
# Empty MNT means "derive a per-run mountpoint next to the backing
# image" (see the MNT_BASE block below); only an explicit --mount-point /
# EVAL_UNDER_MOUNT pins the mount to a fixed path.
MNT="${EVAL_UNDER_MOUNT:-}"
KEEP="${EVAL_UNDER_KEEP:-0}"
SET_HOME="${EVAL_UNDER_HOME_ON_MOUNT:-0}"

# Backward-compat: DATALAD_TESTS_TEMP_FS / DATALAD_TESTS_TEMP_FSSIZE (from
# datalad's original script) are still honoured, but the preferred names
# are EVAL_UNDER_LOOP_FS / EVAL_UNDER_LOOP_SIZE_MB. Only fall back if the
# new name is unset.
FS="${EVAL_UNDER_LOOP_FS:-${DATALAD_TESTS_TEMP_FS:-vfat}}"
SIZE_MB="${EVAL_UNDER_LOOP_SIZE_MB:-${DATALAD_TESTS_TEMP_FSSIZE:-100}}"

ALLOC="${EVAL_UNDER_LOOP_ALLOC:-zero}"
DIRECT_IO="${EVAL_UNDER_LOOP_DIRECT_IO:-0}"
MKFS_OPTS="${EVAL_UNDER_LOOP_MKFS_OPTS:-}"
MOUNT_OPTS="${EVAL_UNDER_LOOP_MOUNT_OPTS:-}"

usage() {
  cat <<'EOF'
Usage: eval-under-loop [OPTIONS] -- CMD [ARGS...]

Run CMD with TMPDIR / DATALAD_TESTS_TEMP_DIR (and optionally HOME)
pointing at a loop-mounted local filesystem. A fresh backing image is
created (see --alloc), mkfs.<fs>'d, and loop-mounted for the duration
of the command.

Requires `mkfs.<fs>` for the chosen filesystem. For the default
(`vfat`) that means `dosfstools`. Also common: `xfsprogs` (xfs),
`e2fsprogs` (ext4, usually preinstalled), `btrfs-progs` (btrfs).

Options (flag / env var / default / purpose):

  --mount-point PATH   EVAL_UNDER_MOUNT               (next to backing image)
      Where to mount the loop device on the host. Default: a fresh
      per-run directory next to the backing image, both under $TMPDIR
      (/tmp if unset) -- e.g. with TMPDIR=~/.tmp:

        ~/.tmp/eval-under-loop-B3UXj.img    backing image
        ~/.tmp/eval-under-loop-B3UXj.loop   where this run mounts it

      The former fixed default (/mnt/loop) collided between concurrent
      runs, needed root just to create the directory, and hid which run
      owned the mount. Pass this option when a stable path is wanted.

  --set-home           EVAL_UNDER_HOME_ON_MOUNT       (unset)
      Also set HOME=<mount>/home for the wrapped command.

  --keep               EVAL_UNDER_KEEP                (unset)
      Skip teardown; leave loop + mount up for debugging.

  --fs TYPE            EVAL_UNDER_LOOP_FS             vfat
      Filesystem to create on the backing image. Anything with a
      matching `mkfs.<type>` works: vfat, ext4, xfs, btrfs, ...

  --size MB            EVAL_UNDER_LOOP_SIZE_MB        100
      Backing image size in megabytes. Bumped from datalad's original
      10 -- git-annex's testsuite fills that in a few seconds.
      btrfs refuses anything under 109 MiB.

  --alloc MODE         EVAL_UNDER_LOOP_ALLOC          zero
      How the backing image gets its size:

        zero       dd from /dev/zero: every block written and allocated
                   on the host up front. Slow and host-space-hungry at
                   large sizes (a TB image is a TB of writes), but
                   works on any host filesystem.
        sparse     truncate: instant, allocates nothing; the host fills
                   in blocks as the filesystem inside writes them. If
                   the host runs out of space, writes inside the image
                   fail with I/O errors rather than ENOSPC.
        fallocate  fallocate(2): reserves every block without writing
                   it -- instant on most hosts (vfat zeroes them in the
                   kernel, so not there). Fails, with no
                   write-everything fallback of its own, where the host
                   does not support it (NFS older than 4.2, ramfs, ext4
                   without extents).

  --direct-io          EVAL_UNDER_LOOP_DIRECT_IO      (unset)
      Attach with `losetup --direct-io=on`, so image I/O bypasses the
      host page cache instead of being cached twice (once for the
      filesystem inside, once for the image file). The env var turns
      it on when set to 1. The host filesystem must support O_DIRECT
      (ramfs does not; tmpfs does since Linux 6.6): current kernels
      then refuse to attach, and this backend stops with an error.
      Older kernels may attach buffered instead; that is warned about.

  --mkfs-opts OPTS     EVAL_UNDER_LOOP_MKFS_OPTS      (unset)
      Extra arguments for mkfs.<fs>, split on whitespace (newlines
      included) with no quoting -- so no argument can contain a space.
      E.g. "-m single" or "-K" (skip the initial discard) for btrfs.

  --mount-opts OPTS    EVAL_UNDER_LOOP_MOUNT_OPTS     (unset)
      Comma-separated options for the loop mount's -o (appended to
      uid=/gid= for vfat and friends), e.g.
      "discard=async,compress=zstd" for btrfs. With "ro" the mountpoint
      cannot be chown'd to the invoking user; that is warned about.

  -h, --help
      Print this help.

Environment variables set FOR the wrapped command (all backends):

  TMPDIR                     = <mount>
  DATALAD_TESTS_TEMP_DIR     = <mount>
  HOME                       = <mount>/home        (only if --set-home)

Deprecated / backward-compat env vars:

  DATALAD_TESTS_TEMP_FS      Alias of EVAL_UNDER_LOOP_FS (datalad-era).
  DATALAD_TESTS_TEMP_FSSIZE  Alias of EVAL_UNDER_LOOP_SIZE_MB.
                             The new names take precedence if both set.

Exit status: the wrapped command's exit status. Teardown runs on any
exit (unless --keep).
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --keep) KEEP=1; shift ;;
    --mount-point) MNT="$2"; shift 2 ;;
    --set-home) SET_HOME=1; shift ;;
    --fs) FS="$2"; shift 2 ;;
    --size) SIZE_MB="$2"; shift 2 ;;
    --alloc) ALLOC="$2"; shift 2 ;;
    --direct-io) DIRECT_IO=1; shift ;;
    --mkfs-opts) MKFS_OPTS="$2"; shift 2 ;;
    --mount-opts) MOUNT_OPTS="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[ $# -gt 0 ] || { echo "no command given" >&2; usage >&2; exit 2; }

case "$SIZE_MB" in
  ''|*[!0-9]*|0) echo "--size must be a positive integer (MB), got: $SIZE_MB" >&2
                 exit 2 ;;
esac

case "$ALLOC" in
  zero|sparse|fallocate) ;;
  *) echo "unknown --alloc mode: $ALLOC (expected zero|sparse|fallocate)" >&2
     exit 2 ;;
esac

# Whitespace-split once here, so an option string cannot glob. read
# stops at the first newline, so fold those into spaces first.
read -ra MKFS_ARGS <<<"${MKFS_OPTS//$'\n'/ }"

if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null || {
    echo "must run as root (or have sudo available)" >&2; exit 2; }
  SUDO=(sudo)
else
  SUDO=()
fi

# Identify the invoking (non-root) user. When script is invoked as
# `sudo eval-under-loop`, the wrapped command / mount uid= option should
# reflect the pre-sudo user, not root.
if [ -n "${SUDO_UID:-}" ]; then
  INVOKER_UID="$SUDO_UID"; INVOKER_GID="${SUDO_GID:-$SUDO_UID}"
else
  INVOKER_UID="$(id -u)"; INVOKER_GID="$(id -g)"
fi

log() { printf '\nI: %s\n' "$*"; }

ensure_mkfs_installed() {
  if command -v "mkfs.$FS" >/dev/null 2>&1; then return 0; fi
  echo "ERROR: mkfs.$FS not found in PATH." >&2
  case "$FS" in
    vfat)   echo "  Install with: apt install dosfstools" >&2 ;;
    xfs)    echo "  Install with: apt install xfsprogs" >&2 ;;
    btrfs)  echo "  Install with: apt install btrfs-progs" >&2 ;;
    ext2|ext3|ext4) echo "  Install with: apt install e2fsprogs" >&2 ;;
    *) echo "  Install the package that provides mkfs.$FS." >&2 ;;
  esac
  exit 3
}

# Backing image, and the mountpoint the loop device is mounted on. Both
# derive from one mktemp -u base, so a run leaves a self-describing pair
# of siblings under $TMPDIR (see --mount-point in usage()).
MNT_BASE="$(mktemp -u "${TMPDIR:-/tmp}/eval-under-loop-XXXXX")"
IMAGE="$MNT_BASE.img"
MNT="${MNT:-$MNT_BASE.loop}"
LOOP=""

# Whether teardown created the mountpoint and may therefore remove it.
MNT_CREATED=0

start_loop() {
  local losetup_opts=(--find --show)
  log "creating ${SIZE_MB}MB backing image $IMAGE (--alloc $ALLOC)"
  case "$ALLOC" in
    # Use bs=1M count=SIZE_MB (portable, unambiguous). datalad's original
    # used bs=1032192 which is a slightly-off historical vfat-cluster
    # rounding; bs=1M is simpler and works for every fs we care about.
    zero)      dd if=/dev/zero "of=$IMAGE" bs=1M "count=$SIZE_MB" status=none ;;
    sparse)    truncate -s "${SIZE_MB}M" "$IMAGE" ;;
    # util-linux fallocate calls fallocate(2) directly; unlike glibc's
    # posix_fallocate() it never falls back to writing every block.
    fallocate) fallocate -l "${SIZE_MB}M" "$IMAGE" ;;
  esac
  echo "I: image on host: $(du -h --apparent-size "$IMAGE" | cut -f1) apparent," \
       "$(du -h "$IMAGE" | cut -f1) allocated"

  if [ "$DIRECT_IO" = 1 ]; then losetup_opts+=(--direct-io=on); fi
  log "losetup ${losetup_opts[*]} $IMAGE"
  if ! LOOP=$("${SUDO[@]}" losetup "${losetup_opts[@]}" "$IMAGE"); then
    if [ "$DIRECT_IO" = 1 ]; then
      echo "E: losetup --direct-io=on failed; the host filesystem under" \
           "$IMAGE likely lacks O_DIRECT. Retry without --direct-io." >&2
    fi
    exit 1
  fi
  echo "I: loop device: $LOOP"
  # Older kernels attach buffered rather than refuse when the host fs
  # cannot do O_DIRECT; say so rather than let a run be read as direct.
  if [ "$DIRECT_IO" = 1 ] \
     && [ "$("${SUDO[@]}" losetup --list --noheadings --output DIO "$LOOP" \
            | tr -d ' ')" != 1 ]; then
    echo "W: --direct-io requested, but $LOOP is using buffered I/O" >&2
  fi

  log "mkfs.$FS${MKFS_ARGS[*]:+ ${MKFS_ARGS[*]}} $LOOP"
  "${SUDO[@]}" "mkfs.$FS" "${MKFS_ARGS[@]}" "$LOOP" >/dev/null
}

mount_loop() {
  local opts
  log "mounting $LOOP ($FS) at $MNT"
  [ -d "$MNT" ] || MNT_CREATED=1
  "${SUDO[@]}" mkdir -p "$MNT"
  # Not every mkfs supports uid= (e.g. ext4 doesn't); pass it only for
  # filesystems that ignore ownership themselves and need it as a mount
  # option to grant the invoking user write access.
  case "$FS" in
    vfat|msdos|exfat|ntfs)
      opts="uid=$INVOKER_UID,gid=$INVOKER_GID${MOUNT_OPTS:+,$MOUNT_OPTS}"
      "${SUDO[@]}" mount -o "$opts" "$LOOP" "$MNT"
      ;;
    *)
      opts="${MOUNT_OPTS:-defaults}"
      "${SUDO[@]}" mount -o "$opts" "$LOOP" "$MNT"
      "${SUDO[@]}" chown "$INVOKER_UID:$INVOKER_GID" "$MNT" \
        || echo "W: could not chown $MNT (mounted with -o $opts)" >&2
      ;;
  esac
  "${SUDO[@]}" mount | grep -F "$MNT" | sed 's/^/I: /'
}

teardown() {
  local rc=$?
  set +e
  if [ "$KEEP" = 1 ]; then
    echo "I: --keep set; leaving loop + mount up (exit=$rc)"
    return "$rc"
  fi
  log "teardown"
  "${SUDO[@]}" umount "$MNT" 2>/dev/null || true
  if [ -n "$LOOP" ]; then
    "${SUDO[@]}" losetup -d "$LOOP" 2>/dev/null || true
  fi
  # Only remove the mountpoint if this run made it: an explicit
  # --mount-point may well be a directory that predates us.
  if [ "$MNT_CREATED" = 1 ]; then
    "${SUDO[@]}" rm -rf "$MNT" 2>/dev/null || true
  fi
  "${SUDO[@]}" rm -f "$IMAGE" 2>/dev/null || true
  return "$rc"
}
trap teardown EXIT

ensure_mkfs_installed
start_loop
mount_loop

RUN_HOME="$HOME"
if [ "$SET_HOME" = 1 ]; then
  RUN_HOME="$MNT/home"
  mkdir -p "$RUN_HOME"
fi

log "running: $*"
HOME="$RUN_HOME" TMPDIR="$MNT" DATALAD_TESTS_TEMP_DIR="$MNT" "$@"
